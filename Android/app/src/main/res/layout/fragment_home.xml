<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Frame 1: Button Group and Step Chart -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        android:padding="8dp">

        <Button
            android:id="@+id/btnToday"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="Today"
            android:backgroundTint="?attr/colorPrimary" />

        <Button
            android:id="@+id/btnTomorrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tomorrow"
            android:layout_marginStart="8dp"
            android:backgroundTint="?attr/colorPrimary" />
    </LinearLayout>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/stepChart"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/buttonContainer"
        app:layout_constraintBottom_toTopOf="@id/dailyPriceInfoFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/noDataText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unit rates not available yet. We normally get these at around 4:30pm today. Please try again in a couple of hours."
        android:layout_gravity="center"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@id/buttonContainer"
        app:layout_constraintBottom_toTopOf="@id/dailyPriceInfoFrame"
        android:visibility="gone"/>

    <!-- Frame 2: Daily Pricing Info -->
    <LinearLayout
        android:id="@+id/dailyPriceInfoFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonContainer">

        <TextView
            android:id="@+id/tvDailyPricingInfoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daily Pricing Info for Today"
            android:textStyle="bold" />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:stretchColumns="0,1,2,3">

            <TableRow>
                <TextView android:text="High Price (p)" />
                <TextView android:text="Low Price (p)" />
                <TextView android:text="Average Price (p)" />
            </TableRow>
            <TableRow>
                <TextView android:id="@+id/tvHighPrice" />
                <TextView android:id="@+id/tvLowPrice" />
                <TextView android:id="@+id/tvAvgPrice" />
            </TableRow>
        </TableLayout>


        <Button
            android:id="@+id/btnViewMore"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:text="View more..."
        android:padding="5dp"
        android:textSize="9sp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"/>

    </LinearLayout>


    <!-- Frame 3: Analytical Information  -->
    <LinearLayout
        android:id="@+id/AnalyticalInfoFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/dailyPriceInfoFrame">

        <TextView
            android:id="@+id/tvTHistoricalDataTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analytical Historical Data"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ThresholdFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:stretchColumns="0,1,2">

                <TableRow>
                    <TextView android:text="Threshold High Price (p)" />
                    <TextView android:text="Threshold Low Price (p)" />
                </TableRow>

                <TableRow>
                    <TextView android:id="@+id/tvThresholdHighPrice" />
                    <TextView android:id="@+id/tvThresholdLowPrice" />
                </TableRow>
            </TableLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/HighRatesPeriodFrame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvHighRatesPeriodTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A period of high prices during the day"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHighRatesHours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="High price hours : "/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_Analytical_Info"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="Analytical Info"
            android:padding="5dp"
            android:textSize="9sp"
            android:layout_gravity="end"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
