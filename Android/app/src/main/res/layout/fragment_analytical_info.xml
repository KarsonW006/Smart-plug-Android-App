<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.AnalyticalInfoFragment">

    <!-- TODO: Update blank fragment layout -->
    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title_monthly_chart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monthly Price Forecast"
            android:textSize="18sp"
            android:padding="16dp" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/lineChartMonthly"
            android:layout_width="match_parent"
            android:layout_height="290dp" />

        <TextView
            android:id="@+id/title_quarterly_chart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quarterly Price Forecast"
            android:textSize="18sp"
            android:padding="16dp" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/lineChartQuarterly"
            android:layout_width="match_parent"
            android:layout_height="290dp" />
    </LinearLayout>
</FrameLayout>