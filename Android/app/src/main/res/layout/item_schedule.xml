<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1st Line: Schedule and Enable Toggle -->
        <ImageView
            android:id="@+id/img_modify_schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="-10dp"
            android:src="@drawable/more_horiz_24px" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_schedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Schedule" />

            <TextView
                android:id="@+id/tv_enable_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disable" /> <!-- Default text -->

            <Switch
                android:id="@+id/switch_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 2nd Line: Start Time and End Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_start_time_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Start Time: " />

            <TextView
                android:id="@+id/tv_start_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="" />

            <TextView
                android:id="@+id/tv_end_time_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End Time: " />

            <TextView
                android:id="@+id/tv_end_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="" />
        </LinearLayout>

        <!-- 3rd Line: Run Mode and Threshold -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_run_mode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Run Mode: " />

            <TextView
                android:id="@+id/tv_run_mode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="" />

            <TextView
                android:id="@+id/tv_threshold_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Threshold: " />

            <TextView
                android:id="@+id/tv_threshold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="" />
        </LinearLayout>

        <!-- 4th Line: Delete Schedule -->
        <ImageView
            android:id="@+id/img_delete_schedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:src="@drawable/ic_delete_24dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
